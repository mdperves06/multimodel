# Backend
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_control_center
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000

# Secrets (generate your own; never commit real values)
# JWT_SECRET:     python -c "import secrets; print(secrets.token_urlsafe(48))"
# ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=
ENCRYPTION_KEY=

# Optional dev-only default; users connect their own keys via the UI
OPENAI_API_KEY=

# Object storage: local | s3 | r2
STORAGE_TYPE=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
