# Copy to .env (or run: python scripts/generate_env.py) and fill in the secrets.
# NEVER commit .env.

# ---- Core -------------------------------------------------------------------------------
ENVIRONMENT=development                # development | production
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_control_center
REDIS_URL=redis://localhost:6379/0     # "memory://" = in-process Redis, local development only

# Docker Compose only: password for the bundled Postgres container
POSTGRES_PASSWORD=postgres

# ---- Secrets (required) -----------------------------------------------------------------
# JWT_SECRET:     python -c "import secrets; print(secrets.token_urlsafe(48))"
# ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing ENCRYPTION_KEY makes stored provider credentials unreadable. Back it up.
JWT_SECRET=
ENCRYPTION_KEY=

# ---- Networking -------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000     # comma-separated, must match the public frontend origin
ALLOWED_HOSTS=*                        # production: your hostname(s), e.g. app.example.com (localhost, 127.0.0.1, backend are always allowed)
TRUST_PROXY=false                      # true only behind a proxy that sets X-Forwarded-For

# ---- Providers --------------------------------------------------------------------------
# Users connect their own API keys in the UI (stored encrypted). This variable is only read
# by the opt-in live check: python backend/scripts/openai_live_check.py
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ENABLE_MOCK_PROVIDER=false             # development/test only; refused in production

# ---- Object storage ---------------------------------------------------------------------
STORAGE_TYPE=local                     # local | s3 | r2
STORAGE_LOCAL_PATH=./storage
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT_URL=                  # required for r2: https://<account>.r2.cloudflarestorage.com
STORAGE_REGION=auto                    # s3: e.g. eu-west-1

# ---- Development conveniences (never in production) ---------------------------------------
EMBEDDED_WORKER=false                  # run the queue worker inside the API process

# ---- Frontend ---------------------------------------------------------------------------
BACKEND_URL=http://localhost:8000      # where the Next.js server proxies /api
